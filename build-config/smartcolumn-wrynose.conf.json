        "meta-yocto": {
            "git-remote": {
                "branch": "wrynose",
                "rev": "7c25b11156553145fa6b241a2d4f65d94438f804",
                "uri": "https://git.yoctoproject.org/meta-yocto"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "branch": "wrynose",
                "rev": "636e5d3b12d54951c13d57346648bc29a0e6b24e",
                "uri": "https://git.openembedded.org/openembedded-core"
            }
        },
        "meta-raspberrypi": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-raspberrypi",
                "branch": "wrynose",
                "rev": "919588393f41b48cb6c5d832aa35e58a19b6762d"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "uri": "https://git.openembedded.org/meta-openembedded",
                "branch": "wrynose",
                "rev": "f28a144aa0a0ae05ca2ee91e1aef6aa05f6a12db"
            }
        },
        "meta-smart-column": {
            "git-remote": {
                "uri": "https://github.com/NikitaBukhta/meta-smart-column.git",
                "branch": "master",
                "rev": "02efde2446239390486eccc945ed70c513c7d7c6"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "name": "smartcolumn",
                "description": "SmartColumn: Poky (systemd), Raspberry Pi BSP, project layer",
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-yocto/meta-poky",
                    "meta-yocto/meta-yocto-bsp",
                    "meta-raspberrypi",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-python",
                    "meta-openembedded/meta-multimedia",
                    "meta-smart-column"
                ],
                "oe-fragments": [
                    "distro/poky-altcfg",
                    "meta-smart-column/audio"
                ],
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Target machine",
                        "options": [
                            {"name": "meta-smart-column/rpi4-64", "description": "Raspberry Pi 4, 64-bit"},
                            {"name": "machine/qemu-rpi4-64", "description": "QEMU arm64 with Raspberry Pi 4 CPU tuning"}
                        ]
                    }
                },
                "setup-dir-name": "smartcolumn-$machine"
            }
        ]
    }
}
