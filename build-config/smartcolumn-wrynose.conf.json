        "bitbake": {
            "git-remote": {
                "branch": "2.18",
                "rev": "51fd94a67fa17650a9ff623492005972bbc7d26f",
                "uri": "https://git.openembedded.org/bitbake"
            }
        },
        "meta-yocto": {
            "git-remote": {
                "branch": "wrynose",
                "rev": "7c25b11156553145fa6b241a2d4f65d94438f804",
                "uri": "https://git.yoctoproject.org/meta-yocto"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "branch": "wrynose",
                "rev": "0f03c732a0a2d0506b41b1abe60b3f368b2300dc",
                "uri": "https://git.openembedded.org/openembedded-core"
            }
        },
        "meta-raspberrypi": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-raspberrypi",
                "branch": "wrynose",
                "rev": "f62c67921474370829d24a4fa01ef88543f3906b"
            }
        },
        "meta-smart-column": {
            "git-remote": {
                "uri": "ssh://git@github.com/NikitaBukhta/meta-smart-column.git",
                "branch": "master",
                "rev": "040343f1e7aca415a3dd3a10d87123ddfb7d7742"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "name": "smartcolumn",
                "description": "SmartColumn: Poky (systemd), Raspberry Pi BSP, project layer",
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-yocto/meta-poky",
                    "meta-yocto/meta-yocto-bsp",
                    "meta-raspberrypi",
                    "meta-smart-column"
                ],
                "oe-fragments": [
                    "distro/poky-altcfg"
                ],
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Target machine",
                        "options": [
                            {"name": "meta-smart-column/rpi4-64", "description": "Raspberry Pi 4, 64-bit"},
                            {"name": "machine/qemu-rpi4-64", "description": "QEMU arm64 with Raspberry Pi 4 CPU tuning"}
                        ]
                    }
                },
                "setup-dir-name": "smartcolumn-$machine"
            }
        ]
    }
}
