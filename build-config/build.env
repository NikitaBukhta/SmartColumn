REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

# Project configuration for bitbake-setup: layers, revision pins, machines.
BB_CONFIG="${BB_CONFIG:-${REPO_ROOT}/build-config/smartcolumn-wrynose.conf.json}"
BB_CONFIG_NAME="${BB_CONFIG_NAME:-smartcolumn}"
BB_SETUP_VERSION="${BB_SETUP_VERSION:-2.19.0}"
# A "machine" option in BB_CONFIG, by the part of its name after the '/'.
BB_MACHINE="${BB_MACHINE:-rpi4-64}"

# Where the build lives
BB_TOP_DIR_NAME="${BB_TOP_DIR_NAME:-bitbake-builds}"
# The name bitbake-setup gives it from "smartcolumn-$machine" in BB_CONFIG.
BB_SETUP_DIR="${BB_SETUP_DIR:-smartcolumn-${BB_MACHINE}}"
BB_MIN_FREE_GB="${BB_MIN_FREE_GB:-50}"
ARTIFACTS_BUILD_RELATIVE_PATH="${ARTIFACTS_BUILD_DIR:-${REPO_ROOT}/${BB_TOP_DIR_NAME}/${BB_SETUP_DIR}/build/tmp/deploy/images/${BB_MACHINE}}"

# What to build.
BB_TARGET="${BB_TARGET:-core-image-minimal}"
read -ra BB_FRAGMENTS <<<"${BB_FRAGMENTS[*]-core/yocto/sstate-mirror-cdn}"
BB_ROOT_LOGIN="${BB_ROOT_LOGIN:-1}"

# Running the built image.
read -ra RUNQEMU_OPTS <<<"${RUNQEMU_OPTS[*]:-nographic slirp snapshot}"

ARTIFACTS_DIR="${ARTIFACTS_DIR:-${REPO_ROOT}/utils/artifacts}"

# Cross-compilation SDK
SDK_TASK="${SDK_TASK:-populate_sdk}"
SDK_DIR="${SDK_DIR:-${ARTIFACTS_DIR}/sdk}"