# Raspberry Pi 4, 64-bit. Only what differs from build-config/build.env; keep
# the VAR="${VAR:-value}" form so the environment can still override it.

# No ssh server in the image yet, so root is reachable on the serial console
# only. Give the board keys or its own user before it goes on a network.
BB_ROOT_LOGIN="${BB_ROOT_LOGIN:-1}"
